PORT=3001
HOST=0.0.0.0
LSP_PORT=3001
LSP_AUTH_TOKEN=replace-with-a-random-secret
LSP_WORKSPACE=/workspace
JDTLS_WORKSPACE=/tmp/jdtls-workspace
LSP_JAVA_ARGS=-data /tmp/jdtls-workspace
LSP_CPP_ARGS=--background-index --query-driver=/usr/bin/g++

# Nombre de la imagen local. Ambas variables son opcionales.
LSP_IMAGE_NAME=ghcr.io/onlinejudgebo/patito-ide-lsp-server:local
LSP_IMAGE_BRANCH=local
